{
  "name": "eslint-plugin-tailwind-classify",
  "version": "0.0.0",
  "description": "ESLint plugin that splits Tailwind class lists onto multiple lines, grouped by semantic category (layout, spacing, typography, ...) with nested variants.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "tailwind",
    "tailwindcss",
    "tailwind-classes",
    "classify",
    "multiline",
    "readable",
    "format",
    "group",
    "category"
  ],
  "license": "MIT",
  "author": "dispbd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispbd/tailwind-classify.git"
  },
  "bugs": {
    "url": "https://github.com/dispbd/tailwind-classify/issues"
  },
  "homepage": "https://github.com/dispbd/tailwind-classify#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
